-- MigrateX Demo: Teradata Source Data
-- Database: TD_DEMO_2908
-- Generates ~3.5M rows directly inside Teradata
--
-- For BTEQ:  .run file = demo/teradata_setup.sql
-- For Teradata Studio: Run each statement block separately
--
-- If running in BTEQ, uncomment the .LOGON line:
-- .LOGON host/username,password

-- Create database (ignore error if exists)
CREATE DATABASE TD_DEMO_2908 AS PERM = 2000000000;

DATABASE TD_DEMO_2908;

-- Drop existing tables one at a time
-- (each DROP is a separate DDL transaction)
DROP TABLE ORDER_ITEMS;

DROP TABLE ORDERS;

DROP TABLE PRODUCTS;

DROP TABLE CUSTOMERS;

-- Create tables (each CREATE is its own implicit transaction)
CREATE TABLE CUSTOMERS (
    CUSTOMER_ID INTEGER NOT NULL,
    FIRST_NAME VARCHAR(50) NOT NULL,
    LAST_NAME VARCHAR(50) NOT NULL,
    EMAIL VARCHAR(120),
    CITY VARCHAR(60),
    STATE VARCHAR(10),
    COUNTRY VARCHAR(10),
    CREATED_AT TIMESTAMP(6) NOT NULL,
    UPDATED_AT TIMESTAMP(6) NOT NULL
) PRIMARY INDEX (CUSTOMER_ID)
;

CREATE TABLE PRODUCTS (
    PRODUCT_ID INTEGER NOT NULL,
    PRODUCT_NAME VARCHAR(100) NOT NULL,
    CATEGORY VARCHAR(30),
    PRICE DECIMAL(10,2),
    STOCK_QTY INTEGER,
    CREATED_AT TIMESTAMP(6) NOT NULL,
    UPDATED_AT TIMESTAMP(6) NOT NULL
) PRIMARY INDEX (PRODUCT_ID)
;

CREATE TABLE ORDERS (
    ORDER_ID INTEGER NOT NULL,
    CUSTOMER_ID INTEGER NOT NULL,
    ORDER_DATE TIMESTAMP(6) NOT NULL,
    STATUS VARCHAR(20),
    TOTAL_AMOUNT DECIMAL(12,2),
    SHIP_CITY VARCHAR(60),
    UPDATED_AT TIMESTAMP(6) NOT NULL
) PRIMARY INDEX (ORDER_ID)
;

CREATE TABLE ORDER_ITEMS (
    ITEM_ID BIGINT NOT NULL,
    ORDER_ID INTEGER NOT NULL,
    PRODUCT_ID INTEGER NOT NULL,
    QUANTITY INTEGER,
    UNIT_PRICE DECIMAL(10,2),
    CREATED_AT TIMESTAMP(6) NOT NULL
) PRIMARY INDEX (ITEM_ID)
;

-- Products (10K)
INSERT INTO PRODUCTS
SELECT
    ROW_NUMBER() OVER (ORDER BY calendar_date) AS PRODUCT_ID,
    CASE (RANDOM(1, 8))
        WHEN 1 THEN 'Premium' WHEN 2 THEN 'Classic' WHEN 3 THEN 'Ultra' WHEN 4 THEN 'Pro'
        WHEN 5 THEN 'Lite' WHEN 6 THEN 'Max' WHEN 7 THEN 'Mini' ELSE 'Eco'
    END || ' ' ||
    CASE (RANDOM(1, 8))
        WHEN 1 THEN 'Widget' WHEN 2 THEN 'Gadget' WHEN 3 THEN 'Sensor' WHEN 4 THEN 'Module'
        WHEN 5 THEN 'Kit' WHEN 6 THEN 'Pack' WHEN 7 THEN 'Set' ELSE 'Cable'
    END || ' ' || TRIM(CAST(ROW_NUMBER() OVER (ORDER BY calendar_date) AS VARCHAR(10))),
    CASE (RANDOM(1, 8))
        WHEN 1 THEN 'Electronics' WHEN 2 THEN 'Clothing' WHEN 3 THEN 'Home' WHEN 4 THEN 'Sports'
        WHEN 5 THEN 'Books' WHEN 6 THEN 'Toys' WHEN 7 THEN 'Food' ELSE 'Auto'
    END,
    CAST(5 + (RANDOM(1, 99500) / 100.0) AS DECIMAL(10,2)),
    RANDOM(0, 10000),
    CAST(CAST(DATE '2024-01-01' + RANDOM(0, 970) AS TIMESTAMP(6)) + (RANDOM(0, 23) * INTERVAL '1' HOUR) + (RANDOM(0, 59) * INTERVAL '1' MINUTE) + (RANDOM(0, 59) * INTERVAL '1' SECOND) AS TIMESTAMP(6)),
    CAST(CAST(DATE '2024-01-01' + RANDOM(0, 970) AS TIMESTAMP(6)) + (RANDOM(0, 23) * INTERVAL '1' HOUR) + (RANDOM(0, 59) * INTERVAL '1' MINUTE) + (RANDOM(0, 59) * INTERVAL '1' SECOND) AS TIMESTAMP(6))
FROM sys_calendar.CALENDAR
WHERE calendar_date BETWEEN DATE '2020-01-01' AND DATE '2047-05-19'
SAMPLE 10000;

-- Customers (500K)
INSERT INTO CUSTOMERS
SELECT
    ROW_NUMBER() OVER (ORDER BY a.calendar_date, b.calendar_date) AS CUSTOMER_ID,
    CASE (RANDOM(1, 10))
        WHEN 1 THEN 'James' WHEN 2 THEN 'Mary' WHEN 3 THEN 'John' WHEN 4 THEN 'Patricia'
        WHEN 5 THEN 'Robert' WHEN 6 THEN 'Jennifer' WHEN 7 THEN 'Michael' WHEN 8 THEN 'Linda'
        WHEN 9 THEN 'David' ELSE 'Elizabeth'
    END,
    CASE (RANDOM(1, 10))
        WHEN 1 THEN 'Smith' WHEN 2 THEN 'Johnson' WHEN 3 THEN 'Williams' WHEN 4 THEN 'Brown'
        WHEN 5 THEN 'Jones' WHEN 6 THEN 'Garcia' WHEN 7 THEN 'Miller' WHEN 8 THEN 'Davis'
        WHEN 9 THEN 'Rodriguez' ELSE 'Martinez'
    END,
    'user' || TRIM(CAST(ROW_NUMBER() OVER (ORDER BY a.calendar_date, b.calendar_date) AS VARCHAR(10))) || '@example.com',
    CASE (RANDOM(1, 10))
        WHEN 1 THEN 'New York' WHEN 2 THEN 'Los Angeles' WHEN 3 THEN 'Chicago' WHEN 4 THEN 'Houston'
        WHEN 5 THEN 'Phoenix' WHEN 6 THEN 'Philadelphia' WHEN 7 THEN 'San Antonio' WHEN 8 THEN 'San Diego'
        WHEN 9 THEN 'Dallas' ELSE 'San Jose'
    END,
    CASE (RANDOM(1, 10))
        WHEN 1 THEN 'NY' WHEN 2 THEN 'CA' WHEN 3 THEN 'IL' WHEN 4 THEN 'TX' WHEN 5 THEN 'AZ'
        WHEN 6 THEN 'PA' WHEN 7 THEN 'TX' WHEN 8 THEN 'CA' WHEN 9 THEN 'TX' ELSE 'CA'
    END,
    CASE WHEN RANDOM(1,5) <= 3 THEN 'US' WHEN RANDOM(1,5) = 4 THEN 'CA' ELSE 'UK' END,
    CAST(CAST(DATE '2024-01-01' + RANDOM(0, 970) AS TIMESTAMP(6)) + (RANDOM(0, 23) * INTERVAL '1' HOUR) + (RANDOM(0, 59) * INTERVAL '1' MINUTE) + (RANDOM(0, 59) * INTERVAL '1' SECOND) AS TIMESTAMP(6)),
    CAST(CAST(DATE '2024-01-01' + RANDOM(0, 970) AS TIMESTAMP(6)) + (RANDOM(0, 23) * INTERVAL '1' HOUR) + (RANDOM(0, 59) * INTERVAL '1' MINUTE) + (RANDOM(0, 59) * INTERVAL '1' SECOND) AS TIMESTAMP(6))
FROM sys_calendar.CALENDAR a
CROSS JOIN sys_calendar.CALENDAR b
WHERE a.calendar_date BETWEEN DATE '2020-01-01' AND DATE '2021-05-15'
  AND b.calendar_date BETWEEN DATE '2020-01-01' AND DATE '2020-12-31'
SAMPLE 500000;

-- Orders (1M)
INSERT INTO ORDERS
SELECT
    ROW_NUMBER() OVER (ORDER BY a.calendar_date, b.calendar_date) AS ORDER_ID,
    RANDOM(1, 500000) AS CUSTOMER_ID,
    CAST(CAST(DATE '2024-01-01' + RANDOM(0, 970) AS TIMESTAMP(6)) + (RANDOM(0, 23) * INTERVAL '1' HOUR) + (RANDOM(0, 59) * INTERVAL '1' MINUTE) + (RANDOM(0, 59) * INTERVAL '1' SECOND) AS TIMESTAMP(6)),
    CASE (RANDOM(1, 6))
        WHEN 1 THEN 'completed' WHEN 2 THEN 'completed' WHEN 3 THEN 'completed'
        WHEN 4 THEN 'shipped' WHEN 5 THEN 'processing' ELSE 'cancelled'
    END,
    CAST(10 + (RANDOM(1, 249000) / 100.0) AS DECIMAL(12,2)),
    CASE (RANDOM(1, 10))
        WHEN 1 THEN 'New York' WHEN 2 THEN 'Los Angeles' WHEN 3 THEN 'Chicago' WHEN 4 THEN 'Houston'
        WHEN 5 THEN 'Phoenix' WHEN 6 THEN 'Philadelphia' WHEN 7 THEN 'San Antonio' WHEN 8 THEN 'San Diego'
        WHEN 9 THEN 'Dallas' ELSE 'San Jose'
    END,
    CAST(CAST(DATE '2024-01-01' + RANDOM(0, 970) AS TIMESTAMP(6)) + (RANDOM(0, 23) * INTERVAL '1' HOUR) + (RANDOM(0, 59) * INTERVAL '1' MINUTE) + (RANDOM(0, 59) * INTERVAL '1' SECOND) AS TIMESTAMP(6))
FROM sys_calendar.CALENDAR a
CROSS JOIN sys_calendar.CALENDAR b
WHERE a.calendar_date BETWEEN DATE '2020-01-01' AND DATE '2022-10-01'
  AND b.calendar_date BETWEEN DATE '2020-01-01' AND DATE '2020-12-31'
SAMPLE 1000000;

-- Order Items (2M)
INSERT INTO ORDER_ITEMS
SELECT
    ROW_NUMBER() OVER (ORDER BY a.calendar_date, b.calendar_date) AS ITEM_ID,
    RANDOM(1, 1000000) AS ORDER_ID,
    RANDOM(1, 10000) AS PRODUCT_ID,
    RANDOM(1, 10) AS QUANTITY,
    CAST(5 + (RANDOM(1, 49500) / 100.0) AS DECIMAL(10,2)),
    CAST(CAST(DATE '2024-01-01' + RANDOM(0, 970) AS TIMESTAMP(6)) + (RANDOM(0, 23) * INTERVAL '1' HOUR) + (RANDOM(0, 59) * INTERVAL '1' MINUTE) + (RANDOM(0, 59) * INTERVAL '1' SECOND) AS TIMESTAMP(6))
FROM sys_calendar.CALENDAR a
CROSS JOIN sys_calendar.CALENDAR b
WHERE a.calendar_date BETWEEN DATE '2020-01-01' AND DATE '2025-06-15'
  AND b.calendar_date BETWEEN DATE '2020-01-01' AND DATE '2020-12-31'
SAMPLE 2000000;

-- Verify row counts
SELECT 'CUSTOMERS' AS TBL, COUNT(*) AS CNT FROM CUSTOMERS
UNION ALL
SELECT 'PRODUCTS', COUNT(*) FROM PRODUCTS
UNION ALL
SELECT 'ORDERS', COUNT(*) FROM ORDERS
UNION ALL
SELECT 'ORDER_ITEMS', COUNT(*) FROM ORDER_ITEMS;
